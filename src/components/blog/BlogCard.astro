---
import type { WPPost } from '../../lib/wordpress/types';
import { getPostFeaturedImage, getPostAuthor, getPostCategoryNames, formatPostDate } from '../../lib/wordpress/posts';

interface Props {
  post: WPPost;
}

const { post } = Astro.props;
const image = getPostFeaturedImage(post) || '/assets/p1/home-hero.jpg';
const author = getPostAuthor(post);
const categories = getPostCategoryNames(post);
const date = formatPostDate(post.date);

// Strip HTML tags from excerpt
const cleanExcerpt = post.excerpt?.rendered
  ? post.excerpt.rendered.replace(/<[^>]+>/g, '').replace(/\[&hellip;\]/, '...').trim()
  : 'Read article for details...';
---

<article class="blog-card">
  <a class="blog-image-wrap" href={`/blog/${post.slug}`} aria-label={`Read ${post.title.rendered}`}>
    <img src={image} alt={post.title.rendered} loading="lazy" />
    {categories.length > 0 && (
      <span class="blog-badge">{categories[0]}</span>
    )}
  </a>
  <div class="blog-body">
    <div class="blog-meta">
      <time datetime={post.date}>{date}</time>
      <span>&bull;</span>
      <span>{author}</span>
    </div>
    <h3>
      <a href={`/blog/${post.slug}`} set:html={post.title.rendered} />
    </h3>
    <p class="blog-excerpt">{cleanExcerpt}</p>
    <a class="blog-read-more" href={`/blog/${post.slug}`}>
      Read Article &rarr;
    </a>
  </div>
</article>

<style>
  .blog-card {
    display: flex;
    flex-direction: column;
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-normal);
    height: 100%;
  }

  .blog-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: rgba(7, 26, 52, 0.25);
  }

  .blog-image-wrap {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: var(--color-navy);
  }

  .blog-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .blog-card:hover .blog-image-wrap img {
    transform: scale(1.05);
  }

  .blog-badge {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    background-color: rgba(7, 26, 52, 0.85);
    backdrop-filter: blur(4px);
    color: var(--color-gold);
    font-size: var(--text-xs);
    font-weight: 700;
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    letter-spacing: 0.04em;
  }

  .blog-body {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: var(--space-2);
  }

  .blog-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .blog-body h3 {
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.35;
    color: var(--color-navy);
  }

  .blog-body h3 a:hover {
    color: var(--color-blue);
  }

  .blog-excerpt {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-top: var(--space-2);
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-read-more {
    color: var(--color-blue);
    font-size: var(--text-sm);
    font-weight: 700;
    margin-top: var(--space-3);
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    transition: transform var(--transition-fast);
  }

  .blog-card:hover .blog-read-more {
    transform: translateX(4px);
    color: var(--color-navy);
  }
</style>
