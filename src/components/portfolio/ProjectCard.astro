---
import type { ProjectItem } from '../../lib/wordpress/types';

interface Props {
  project: ProjectItem;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
---

<a class={`project-card ${featured ? 'featured' : ''}`} href={`/projects/${project.slug}`}>
  <div class="card-image-wrap">
    <img src={project.image} alt={project.title} loading="lazy" />
    <span class="card-badge">{project.category}</span>
  </div>
  <div class="card-body">
    <h3>{project.title}</h3>
    <div class="card-meta">
      <span class="client">{project.client}</span>
      <span class="location">&loz; {project.location}</span>
    </div>
    <p class="card-desc">
      {project.scope.slice(0, 3).join(' • ')}
    </p>
    <span class="card-link">View Details &rarr;</span>
  </div>
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: all var(--transition-normal);
    box-shadow: var(--shadow-sm);
    height: 100%;
  }

  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: rgba(7, 26, 52, 0.25);
  }

  .card-image-wrap {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: var(--color-navy);
  }

  .card-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .project-card:hover .card-image-wrap img {
    transform: scale(1.05);
  }

  .card-badge {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    background-color: rgba(7, 26, 52, 0.85);
    backdrop-filter: blur(4px);
    color: var(--color-gold);
    font-size: var(--text-xs);
    font-weight: 700;
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    letter-spacing: 0.04em;
    border: 1px solid rgba(246, 185, 54, 0.3);
  }

  .card-body {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: var(--space-2);
  }

  .card-body h3 {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-navy);
    line-height: 1.3;
  }

  .card-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: var(--text-xs);
  }

  .card-meta .client {
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .card-meta .location {
    color: var(--color-text-muted);
  }

  .card-desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin-top: var(--space-2);
    flex: 1;
  }

  .card-link {
    color: var(--color-blue);
    font-size: var(--text-sm);
    font-weight: 700;
    margin-top: var(--space-3);
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    transition: all var(--transition-fast);
  }

  .project-card:hover .card-link {
    color: var(--color-navy);
    transform: translateX(4px);
  }
</style>
