---
import BaseLayout from '../layouts/BaseLayout.astro';
import StatsBar from '../components/ui/StatsBar.astro';
import CtaSection from '../components/ui/CtaSection.astro';

const industries = [
  {
    cat: 'mining',
    name: 'Mining Industry',
    icon: '◇',
    image: '/assets/p2/mining.jpg',
    desc: 'Solusi konstruksi dan infrastruktur sipil untuk mendukung operasional site pertambangan yang aman, terjal, dan membutuhkan kehandalan tinggi.',
  },
  {
    cat: 'oil',
    name: 'Oil & Gas Industry',
    icon: '♟',
    image: '/assets/p2/oil-gas.jpg',
    desc: 'Pembangunan dan pemeliharaan fasilitas dengan kepatuhan standar keselamatan kerja (HSE) ketat untuk sektor minyak dan gas bumi.',
  },
  {
    cat: 'manufacturing',
    name: 'Manufacturing Industry',
    icon: '▣',
    image: '/assets/p2/manufacturing.jpg',
    desc: 'Solusi pembangunan pabrik, renovasi site, pengadaan infrastruktur, dan integrasi teknologi untuk mendukung produktivitas lini manufaktur.',
  },
  {
    cat: 'plantation',
    name: 'Plantation Industry',
    icon: '♧',
    image: '/assets/p2/plantation.jpg',
    desc: 'Pembangunan infrastruktur fasilitas pemrosesan, gudang, dan pemeliharaan fasilitas untuk mendukung kelancaran operasional agrikultur.',
  },
  {
    cat: 'infrastructure',
    name: 'Infrastructure & Transportation',
    icon: '⌂',
    image: '/assets/p2/infrastructure.jpg',
    desc: 'Pekerjaan sipil dan infrastruktur pendukung untuk jalan tol, jembatan, rest area, dan fasilitas transportasi publik modern.',
  },
  {
    cat: 'commercial',
    name: 'Commercial Building',
    icon: '▥',
    image: '/assets/p2/commercial.jpg',
    desc: 'Konstruksi dan fit-out gedung perkantoran, warehouse logistik, dan fasilitas komersial dengan desain fungsional dan estetika elegan.',
  },
  {
    cat: 'public',
    name: 'Public Facility & Healthcare',
    icon: '▤',
    image: '/assets/p2/public-facility.jpg',
    desc: 'Pembangunan dan renovasi fasilitas publik seperti rumah sakit, sarana kesehatan, dan gedung pelayanan masyarakat berstandar tinggi.',
  },
  {
    cat: 'integrated',
    name: 'Integrated High-Tech Solutions',
    icon: '⌘',
    image: '/assets/p2/integrated.jpg',
    desc: 'Integrasi konstruksi fisik, command center, jaringan fiber optic, dan teknologi keamanan pintar untuk ekosistem industri modern.',
  },
];

const filters = [
  { label: 'All Industries', value: 'all', icon: '▦' },
  { label: 'Mining', value: 'mining', icon: '◇' },
  { label: 'Oil & Gas', value: 'oil', icon: '♟' },
  { label: 'Manufacturing', value: 'manufacturing', icon: '▣' },
  { label: 'Plantation', value: 'plantation', icon: '♧' },
  { label: 'Infrastructure', value: 'infrastructure', icon: '⌂' },
  { label: 'Commercial', value: 'commercial', icon: '▥' },
  { label: 'Public Facility', value: 'public', icon: '▤' },
];
---

<BaseLayout
  title="Industries | Visi Bangun Perkasa"
  description="Building solutions for key industries by PT. Visi Bangun Perkasa across Indonesia."
>
  <!-- Hero Section -->
  <section class="page-hero" style="background-image: url('/assets/p2/hero.jpg');">
    <div class="page-hero-overlay"></div>
    <div class="container">
      <div class="eyebrow">INDUSTRIES</div>
      <h1>Building Solutions<br />for <em>Every Industry</em></h1>
      <p>
        Kami memahami setiap industri memiliki tantangan dan kebutuhan yang unik. Dengan pengalaman lintas sektor, kami menyediakan solusi konstruksi, renovasi, facility maintenance, dan teknologi terintegrasi yang disesuaikan dengan standar industri dan kebutuhan operasional Anda.
      </p>
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>&rsaquo;</span>
        <span>Industries</span>
      </nav>
    </div>
  </section>

  <!-- Content & Filterable Grid -->
  <section class="section industries-section">
    <div class="container">
      <!-- Filter Pills -->
      <div class="filter-pills" role="tablist" aria-label="Industry filters">
        {filters.map((f, i) => (
          <button
            class={`pill-btn ${i === 0 ? 'active' : ''}`}
            data-filter={f.value}
            type="button"
          >
            <span>{f.icon}</span>
            <span>{f.label}</span>
          </button>
        ))}
      </div>

      <!-- Grid Cards -->
      <div class="industry-cards-grid" id="industry-cards-container">
        {industries.map((ind) => (
          <article class="ind-card" data-cat={ind.cat}>
            <div class="ind-img-wrap">
              <img src={ind.image} alt={ind.name} loading="lazy" />
              <div class="ind-img-overlay"></div>
              <span class="ind-icon">{ind.icon}</span>
            </div>
            <div class="ind-body">
              <h3>{ind.name}</h3>
              <p>{ind.desc}</p>
              <a class="ind-cta" href={`/contact?industry=${encodeURIComponent(ind.name)}`}>
                Discuss Needs &rarr;
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Choose Us Across Industries -->
  <section class="section section-dark why-across-ind">
    <div class="container">
      <div class="section-head split">
        <div>
          <div class="eyebrow">WHY CHOOSE US</div>
          <h2>Partner You Can Rely On <em>Across Industries</em></h2>
        </div>
        <p>
          Dengan pemahaman mendalam terhadap karakteristik operasional dan regulasi setiap industri, kami memberikan solusi yang tepat sasaran, terukur, dan aman.
        </p>
      </div>

      <div class="why-ind-grid">
        <div class="why-ind-item">
          <span class="wi-icon">⚙</span>
          <h4>Industry Expertise</h4>
          <p>Pengalaman rekayasa lintas sektor dengan standar keselamatan dan kepatuhan industri yang ketat.</p>
        </div>
        <div class="why-ind-item">
          <span class="wi-icon">▤</span>
          <h4>Customized Solutions</h4>
          <p>Solusi teknis yang disesuaikan dengan kondisi lapangan, beban operasional, dan target spesifik klien.</p>
        </div>
        <div class="why-ind-item">
          <span class="wi-icon">◇</span>
          <h4>Safety &amp; Compliance</h4>
          <p>Mengutamakan keselamatan kerja (Zero Accident mindset) dan kepatuhan terhadap regulasi nasional.</p>
        </div>
        <div class="why-ind-item">
          <span class="wi-icon">⌘</span>
          <h4>Integrated Approach</h4>
          <p>Menggabungkan kemampuan konstruksi fisik, fasilitas MEP, dan otomatisasi IT dalam satu kendali terpadu.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Bar -->
  <StatsBar />

  <!-- CTA Section -->
  <CtaSection />
</BaseLayout>

<style>
  /* Filter Pills */
  .filter-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .pill-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 10px 18px;
    border-radius: var(--radius-full);
    background-color: var(--color-bg-light);
    border: 1px solid var(--color-border);
    color: var(--color-text-primary);
    font-size: var(--text-xs);
    font-weight: 700;
    transition: all var(--transition-fast);
  }

  .pill-btn:hover {
    border-color: var(--color-navy);
    background-color: #ffffff;
  }

  .pill-btn.active {
    background-color: var(--color-navy);
    color: var(--color-gold);
    border-color: var(--color-navy);
    box-shadow: 0 4px 12px rgba(7, 26, 52, 0.2);
  }

  /* Cards Grid */
  .industry-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 600px) {
    .industry-cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .industry-cards-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .ind-card {
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    transition: all var(--transition-normal);
  }

  .ind-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: rgba(7, 26, 52, 0.25);
  }

  .ind-card.hidden {
    display: none;
  }

  .ind-img-wrap {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: var(--color-navy);
  }

  .ind-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .ind-card:hover .ind-img-wrap img {
    transform: scale(1.06);
  }

  .ind-img-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(7, 26, 52, 0.1) 0%, rgba(7, 26, 52, 0.6) 100%);
  }

  .ind-icon {
    position: absolute;
    bottom: var(--space-3);
    right: var(--space-3);
    color: var(--color-gold);
    font-size: 1.5rem;
    background: rgba(7, 26, 52, 0.85);
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ind-body {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: var(--space-2);
  }

  .ind-body h3 {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-navy);
  }

  .ind-body p {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
    flex: 1;
  }

  .ind-cta {
    color: var(--color-blue);
    font-size: var(--text-xs);
    font-weight: 700;
    margin-top: var(--space-3);
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    transition: transform var(--transition-fast);
  }

  .ind-card:hover .ind-cta {
    transform: translateX(4px);
    color: var(--color-navy);
  }

  /* Why across ind */
  .why-ind-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 600px) {
    .why-ind-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .why-ind-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .why-ind-item {
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-md);
    padding: var(--space-6);
  }

  .wi-icon {
    font-size: 1.75rem;
    color: var(--color-gold);
    margin-bottom: var(--space-3);
    display: block;
  }

  .why-ind-item h4 {
    font-size: var(--text-base);
    font-weight: 700;
    color: #ffffff;
    margin-bottom: var(--space-2);
  }

  .why-ind-item p {
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.6;
  }
</style>

<script>
  function setupFilters() {
    const buttons = document.querySelectorAll('.pill-btn');
    const cards = document.querySelectorAll('.ind-card');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        const filter = btn.getAttribute('data-filter');
        cards.forEach((card) => {
          const cat = card.getAttribute('data-cat');
          if (filter === 'all' || cat === filter) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });
  }

  setupFilters();
  document.addEventListener('astro:after-swap', setupFilters);
</script>
