---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaSection from '../components/ui/CtaSection.astro';

const services = [
  {
    id: 'construction',
    num: '01',
    icon: '⌂',
    title: 'Construction & Civil Infrastructure',
    image: '/assets/p7/service-construction.jpg',
    lead: 'Pembangunan gedung, infrastruktur, dan konstruksi industri dengan standar kualitas tinggi, kepatuhan teknis, dan ketepatan waktu.',
    items: [
      'Building Construction (Pabrik, Gudang, Gedung Kantor)',
      'Civil & Infrastructure Works (Jalan, Saluran, Pematangan Lahan)',
      'Structural Works (Konstruksi Baja & Beton Bertulang)',
      'Industrial Construction & Plant Facilities',
    ],
  },
  {
    id: 'renovation',
    num: '02',
    icon: '▦',
    title: 'Renovation & Interior Fit-Out',
    image: '/assets/p7/service-renovation.jpg',
    lead: 'Layanan renovasi gedung komersial, interior kantor, fasilitas publik, dan pengadaan material yang fungsional, modern, dan ergonomis.',
    items: [
      'Building Renovation & Structural Retrofitting',
      'Office & Commercial Interior Fit-Out',
      'Interior & Exterior Architectural Works',
      'Supply & Pengadaan Material Proyek Industri',
    ],
  },
  {
    id: 'maintenance',
    num: '03',
    icon: '⚙',
    title: 'Facility Maintenance & Engineering',
    image: '/assets/p7/service-maintenance.jpg',
    lead: 'Pemeliharaan fasilitas operasional dan sistem MEP pendukung gedung untuk menjaga kehandalan operasional serta memperpanjang usia aset.',
    items: [
      'HVAC Systems (Chiller, AHU, VRV, Ducting)',
      'Electrical & Genset Systems (Panel Distribusi, Transformator, Genset)',
      'Routine & Preventive Building Maintenance',
      'Fire Protection & Suppression Systems',
    ],
  },
  {
    id: 'integrated',
    num: '04',
    icon: '⌘',
    title: 'Integrated Technology & Security Solutions',
    image: '/assets/p7/service-integrated.jpg',
    lead: 'Solusi teknologi terintegrasi untuk mendukung keamanan fisik, konektivitas digital, dan operasional command center industri modern.',
    items: [
      'CCTV Surveillance & Access Control Systems',
      'Network, Server Rack & Fiber Optic Backbone',
      'Lightning Protection & Earthing Systems',
      'Control Room, SOC & Videowall Display Solutions',
    ],
  },
];

const whyChooseUs = [
  { icon: '◇', title: 'Integrated Solutions', desc: 'Solusi end-to-end yang menyatukan konstruksi fisik, fasilitas MEP, dan teknologi informasi.' },
  { icon: '◎', title: 'Efficiency & Cost Optimization', desc: 'Pendekatan rekayasa berbasis Total Cost of Ownership (TCO) untuk efisiensi investasi jangka panjang.' },
  { icon: '♢', title: 'Industrial Experience', desc: 'Pengalaman mendalam menangani karakteristik unik sektor manufaktur, mining, oil & gas, dan fasilitas publik.' },
  { icon: '♧', title: 'Reliable Execution', desc: 'Komitmen penuh terhadap disiplin mutu, target jadwal ketat, dan standar keselamatan kerja (HSE).' },
  { icon: '♙', title: 'Responsive & Professional Team', desc: 'Dukungan tim engineer dan manajemen proyek yang komunikatif, adaptif, dan berorientasi solusi.' },
];
---

<BaseLayout
  title="Services | Visi Bangun Perkasa"
  description="Integrated construction, renovation, facility maintenance and technology solutions by PT. Visi Bangun Perkasa across Indonesia."
>
  <!-- Hero Section -->
  <section class="page-hero" style="background-image: url('/assets/p7/services-hero.jpg');">
    <div class="page-hero-overlay"></div>
    <div class="container">
      <div class="eyebrow">OUR SERVICES</div>
      <h1>Integrated Solutions<br />for <em>Industrial &amp; Commercial Needs</em></h1>
      <p>
        Dari konstruksi, renovasi, hingga facility maintenance dan solusi teknologi terintegrasi, VBP menyediakan layanan end-to-end yang dirancang sesuai kebutuhan operasional dengan standar kualitas tinggi dan berfokus pada keamanan, efisiensi, dan keberlanjutan.
      </p>
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>&rsaquo;</span>
        <span>Services</span>
      </nav>
    </div>
  </section>

  <!-- Core Services -->
  <section class="section services-core">
    <div class="container">
      <div class="section-head split">
        <div>
          <div class="eyebrow">Our Services</div>
          <h2>Four Core Services for Your Business</h2>
        </div>
        <p>
          Kami menyediakan layanan terintegrasi untuk mendukung kebutuhan proyek dan operasional bangunan industri, komersial, dan fasilitas umum dengan pendekatan profesional dan berorientasi solusi.
        </p>
      </div>

      <div class="services-stack">
        {services.map((svc) => (
          <article class="service-detail-card" id={svc.id}>
            <div class="card-visual">
              <img src={svc.image} alt={svc.title} loading="lazy" />
              <div class="card-visual-overlay"></div>
              <span class="card-num">{svc.num}</span>
              <span class="card-icon">{svc.icon}</span>
            </div>
            <div class="card-content">
              <h3>{svc.title}</h3>
              <p class="service-lead">{svc.lead}</p>
              <div class="service-scope-list">
                <h4>Scope of Capabilities:</h4>
                <ul>
                  {svc.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
              <div class="card-cta">
                <a class="btn btn-gold" href={`/contact?service=${encodeURIComponent(svc.title)}`}>
                  Discuss Project &rarr;
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Approach Section -->
  <section class="section section-light services-approach">
    <div class="container">
      <div class="section-head split">
        <div>
          <div class="eyebrow">Our Approach</div>
          <h2>From Planning to Long-Term Partnership</h2>
        </div>
        <p>
          Kami menerapkan pendekatan terstruktur untuk memastikan setiap proyek berjalan dengan efektif, efisien, dan memberikan nilai jangka panjang.
        </p>
      </div>

      <div class="approach-steps-grid">
        <div class="approach-step-card">
          <div class="step-header">
            <span class="step-badge">01</span>
            <h4>Consultation</h4>
          </div>
          <p>Memahami kebutuhan spesifik operasional klien, parameter teknis, dan perumusan solusi terbaik.</p>
        </div>

        <div class="approach-step-card">
          <div class="step-header">
            <span class="step-badge">02</span>
            <h4>Planning &amp; Design</h4>
          </div>
          <p>Penyusunan gambar kerja, Bill of Quantity (BOQ), analisis risiko, dan rencana eksekusi terukur.</p>
        </div>

        <div class="approach-step-card">
          <div class="step-header">
            <span class="step-badge">03</span>
            <h4>Execution</h4>
          </div>
          <p>Implementasi di lapangan oleh tim profesional dengan pengawasan ketat terhadap mutu, jadwal, dan HSE.</p>
        </div>

        <div class="approach-step-card">
          <div class="step-header">
            <span class="step-badge">04</span>
            <h4>Maintenance</h4>
          </div>
          <p>Dukungan purna-jual dan pemeliharaan berkala untuk menjaga keandalan dan performa maksimal aset.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="section section-dark why-vbp">
    <div class="container">
      <div class="section-head split">
        <div>
          <div class="eyebrow">WHY CHOOSE VBP</div>
          <h2>Your Trusted Partner for <em>Sustainable Growth</em></h2>
        </div>
        <p>
          Kami menghadirkan solusi yang tidak hanya menjawab kebutuhan hari ini, tetapi juga mendukung pertumbuhan jangka panjang bisnis Anda.
        </p>
      </div>

      <div class="why-grid">
        {whyChooseUs.map((item) => (
          <div class="why-card">
            <span class="why-icon">{item.icon}</span>
            <h4>{item.title}</h4>
            <p>{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <CtaSection />
</BaseLayout>

<style>
  /* Services Stack */
  .services-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .service-detail-card {
    display: grid;
    grid-template-columns: 1fr;
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-normal);
  }

  @media (min-width: 900px) {
    .service-detail-card {
      grid-template-columns: 420px 1fr;
    }
  }

  .service-detail-card:hover {
    box-shadow: var(--shadow-md);
    border-color: rgba(7, 26, 52, 0.25);
  }

  .card-visual {
    position: relative;
    min-height: 260px;
    background-color: var(--color-navy);
    overflow: hidden;
  }

  .card-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-visual-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(7, 26, 52, 0.2) 0%, rgba(7, 26, 52, 0.7) 100%);
  }

  .card-num {
    position: absolute;
    top: var(--space-4);
    left: var(--space-4);
    color: var(--color-gold);
    font-size: var(--text-xl);
    font-weight: 800;
  }

  .card-icon {
    position: absolute;
    bottom: var(--space-4);
    right: var(--space-4);
    font-size: 1.75rem;
    color: rgba(255, 255, 255, 0.85);
  }

  .card-content {
    padding: clamp(24px, 3.5vw, 40px);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .card-content h3 {
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--color-navy);
    line-height: 1.25;
  }

  .service-lead {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .service-scope-list {
    margin-top: var(--space-2);
  }

  .service-scope-list h4 {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-navy);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-2);
  }

  .service-scope-list ul {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
  }

  @media (min-width: 600px) {
    .service-scope-list ul {
      grid-template-columns: 1fr 1fr;
    }
  }

  .service-scope-list li {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    position: relative;
    padding-left: 14px;
    line-height: 1.5;
  }

  .service-scope-list li::before {
    content: '•';
    position: absolute;
    left: 0;
    color: var(--color-gold);
    font-size: 1.1em;
  }

  .card-cta {
    margin-top: var(--space-4);
  }

  /* Approach Steps */
  .approach-steps-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 600px) {
    .approach-steps-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .approach-steps-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .approach-step-card {
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    box-shadow: var(--shadow-sm);
  }

  .step-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .step-badge {
    background-color: var(--color-navy);
    color: var(--color-gold);
    font-weight: 800;
    font-size: var(--text-xs);
    width: 32px;
    height: 32px;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .step-header h4 {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-navy);
  }

  .approach-step-card p {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  /* Why VBP */
  .why-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 600px) {
    .why-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .why-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-6);
    }
  }

  .why-card {
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    transition: all var(--transition-normal);
  }

  .why-card:hover {
    background-color: rgba(255, 255, 255, 0.08);
    transform: translateY(-2px);
    border-color: var(--color-gold);
  }

  .why-icon {
    font-size: 1.75rem;
    color: var(--color-gold);
    margin-bottom: var(--space-3);
    display: block;
  }

  .why-card h4 {
    font-size: var(--text-lg);
    font-weight: 700;
    color: #ffffff;
    margin-bottom: var(--space-2);
  }

  .why-card p {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.6;
  }
</style>
