---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/blog/BlogCard.astro';
import CtaSection from '../../components/ui/CtaSection.astro';
import { getPosts, getCategories } from '../../lib/wordpress/posts';

const posts = await getPosts({ perPage: 12 });
const categories = await getCategories();
---

<BaseLayout
  title="Blog & Insights | Visi Bangun Perkasa"
  description="Artikel, wawasan industri konstruksi, pemeliharaan fasilitas dan inovasi teknologi oleh PT. Visi Bangun Perkasa."
>
  <!-- Hero Section -->
  <section class="page-hero" style="background-image: url('/assets/p1/home-hero.jpg');">
    <div class="page-hero-overlay"></div>
    <div class="container">
      <div class="eyebrow">BLOG &amp; INSIGHTS</div>
      <h1>Articles &amp; <em>Industry Insights</em></h1>
      <p>
        Wawasan seputar tren konstruksi industri, rekayasa sipil, facility maintenance, dan integrasi teknologi terkini untuk efisiensi bisnis Anda.
      </p>
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>&rsaquo;</span>
        <span>Blog</span>
      </nav>
    </div>
  </section>

  <!-- Blog Listing -->
  <section class="section blog-listing-section">
    <div class="container">
      {categories.length > 0 && (
        <div class="category-filters">
          <span class="filter-label">Categories:</span>
          {categories.map((cat) => (
            <span class="cat-pill">{cat.name} ({cat.count})</span>
          ))}
        </div>
      )}

      {posts.length > 0 ? (
        <div class="blog-grid">
          {posts.map((post) => (
            <BlogCard post={post} />
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <div class="empty-icon">&#9993;</div>
          <h3>Belum ada artikel yang dipublikasikan</h3>
          <p>Kunjungi kembali halaman ini untuk update berita dan artikel terkini dari tim kami.</p>
          <a class="btn btn-gold" href="/">Kembali ke Beranda &rarr;</a>
        </div>
      )}
    </div>
  </section>

  <!-- CTA Section -->
  <CtaSection />
</BaseLayout>

<style>
  .category-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .filter-label {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-navy);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-right: var(--space-2);
  }

  .cat-pill {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-secondary);
    background-color: var(--color-bg-light);
    border: 1px solid var(--color-border);
    padding: 6px 14px;
    border-radius: var(--radius-full);
  }

  .blog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 600px) {
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .blog-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .empty-state {
    text-align: center;
    padding: var(--space-16) var(--space-4);
    background-color: var(--color-bg-light);
    border-radius: var(--radius-lg);
    border: 1px dashed var(--color-border);
    max-width: 600px;
    margin: 0 auto;
  }

  .empty-icon {
    font-size: 3rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .empty-state h3 {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-navy);
    margin-bottom: var(--space-2);
  }

  .empty-state p {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-6);
  }
</style>
