---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaSection from '../components/ui/CtaSection.astro';
---

<BaseLayout
  title="About Us | Visi Bangun Perkasa"
  description="About Us — PT. Visi Bangun Perkasa, Trusted Partner for Industrial Construction & Integrated Solutions across Indonesia."
>
  <!-- Hero Section -->
  <section class="page-hero" style="background-image: url('/assets/p8/about-hero.jpg');">
    <div class="page-hero-overlay"></div>
    <div class="container">
      <div class="eyebrow">About Us</div>
      <h1>Build with Precision,<br />Connected with <span>Technology</span></h1>
      <p>
        Kami hadir sebagai partner strategis yang tidak hanya menyediakan layanan konstruksi, tetapi juga memberikan solusi end-to-end yang terukur, scalable, dan berkelanjutan.
      </p>
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>&rsaquo;</span>
        <span>About Us</span>
      </nav>
    </div>
  </section>

  <!-- Company Overview -->
  <section class="section about-company">
    <div class="container company-grid">
      <div class="company-text">
        <div class="eyebrow dark">Our Company</div>
        <h2>PT. Visi Bangun Perkasa</h2>
        <p>
          PT. Visi Bangun Perkasa adalah perusahaan yang bergerak di bidang konstruksi sipil, renovasi, fasility maintenance, serta integrasi solusi teknologi terapan. Kami berfokus pada penyediaan layanan rekayasa konstruksi untuk sektor industri strategis seperti Manufacturing, Mining, Oil &amp; Gas, Plantation, dan commercial infrastructure.
        </p>
        <p>
          Dengan pengalaman lebih dari 15 tahun di bidang konstruksi dan rekayasa teknologi terintegrasi, kami memahami dinamika kebutuhan industri akan standar kualitas tinggi, ketepatan timeline, efisiensi biaya, dan kepatuhan HSE (Health, Safety, Environment) dalam setiap tahapan proyek.
        </p>
      </div>
      <div class="team-photo-wrap">
        <img src="/assets/p8/about-team-ai.png" alt="Tim konstruksi PT. Visi Bangun Perkasa" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- Highlights & Real Numbers -->
  <section class="section section-light about-highlights">
    <div class="container">
      <div class="section-head split">
        <div>
          <div class="eyebrow">Company Highlights</div>
          <h2>Our Journey in Real Numbers</h2>
        </div>
        <p>
          Bukti dedikasi, rekam jejak, dan kepercayaan para mitra korporasi terkemuka di berbagai sektor industri di Indonesia.
        </p>
      </div>

      <div class="highlight-grid">
        <div class="highlight-card">
          <span class="hl-badge">★</span>
          <strong>15+</strong>
          <span>Years Combined Experience</span>
        </div>
        <div class="highlight-card">
          <span class="hl-badge">&#9638;</span>
          <strong>50+</strong>
          <span>Completed Projects</span>
        </div>
        <div class="highlight-card">
          <span class="hl-badge">&#9823;</span>
          <strong>10+</strong>
          <span>Corporate Clients</span>
        </div>
        <div class="highlight-card map-card">
          <img src="/assets/p8/indonesia-map.png" alt="Peta jangkauan wilayah Indonesia" loading="lazy" />
          <strong>All Indonesia</strong>
          <span>Coverage Area</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Vision & Mission -->
  <section class="section section-dark vision-mission">
    <div class="container vm-container">
      <div class="vm-image">
        <img src="/assets/p8/office-1.jpg" alt="Visi Bangun Perkasa Office" loading="lazy" />
      </div>
      <div class="vm-content">
        <div class="vm-block">
          <div class="eyebrow">Our Vision</div>
          <h3>Vision</h3>
          <p>
            Menjadi perusahaan terdepan dalam penyediaan solusi konstruksi dan teknologi terintegrasi di Indonesia yang terpercaya, inovatif, dan berkelanjutan.
          </p>
        </div>

        <div class="vm-divider"></div>

        <div class="vm-block">
          <div class="eyebrow">Our Mission</div>
          <h3>Mission</h3>
          <ol class="mission-list">
            <li>Menyediakan layanan konstruksi dan pengadaan dengan standar kualitas tinggi dan berbasis teknologi modern.</li>
            <li>Mengintegrasikan solusi IT &amp; infrastruktur fisik untuk meningkatkan efisiensi operasional klien.</li>
            <li>Membangun kemitraan jangka panjang dengan pendekatan profesional, transparan, dan berbasis value.</li>
            <li>Mengedepankan integritas, keselamatan kerja, kehandalan, dan kepuasan pelanggan sebagai prioritas utama.</li>
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- Values & Credentials -->
  <section class="section values-section">
    <div class="container values-creds-grid">
      <!-- Values -->
      <div class="values-col">
        <div class="eyebrow dark">Our Values</div>
        <h2>Nilai-Nilai Perusahaan</h2>
        <div class="values-grid">
          <div class="value-card">
            <div class="value-icon">
              <svg viewBox="0 0 48 48" aria-hidden="true" width="28" height="28"><path d="M24 5l15 6v10c0 9.6-6.4 17.9-15 21-8.6-3.1-15-11.4-15-21V11l15-6z" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M16 24l5 5 11-12" fill="none" stroke="currentColor" stroke-width="2.5"/></svg>
            </div>
            <h4>Integrity</h4>
            <p>Menjunjung tinggi etika, kejujuran, dan transparansi dalam setiap aspek kemitraan kerja.</p>
          </div>

          <div class="value-card">
            <div class="value-icon">
              <svg viewBox="0 0 48 48" aria-hidden="true" width="28" height="28"><path d="M19 7h10l2 5 4 2 5-1 5 8-4 4v5l4 4-5 8-5-1-4 2-2 5H19l-2-5-4-2-5 1-5-8 4-4v-5l-4-4 5-8 5 1 4-2 2-5z" fill="none" stroke="currentColor" stroke-width="2.5"/><circle cx="24" cy="24" r="6" fill="none" stroke="currentColor" stroke-width="2.5"/></svg>
            </div>
            <h4>Excellence</h4>
            <p>Berkomitmen pada presisi teknis, ketepatan waktu, dan standar hasil terbaik.</p>
          </div>

          <div class="value-card">
            <div class="value-icon">
              <svg viewBox="0 0 48 48" aria-hidden="true" width="28" height="28"><circle cx="17" cy="18" r="5" fill="none" stroke="currentColor" stroke-width="2.5"/><circle cx="31" cy="18" r="5" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M7 36c1-7 5-10 10-10s9 3 10 10M21 36c1-6 5-9 10-9s9 3 10 9" fill="none" stroke="currentColor" stroke-width="2.5"/></svg>
            </div>
            <h4>Collaboration</h4>
            <p>Membangun komunikasi proaktif dan kemitraan jangka panjang berbasis solusi bersama.</p>
          </div>

          <div class="value-card">
            <div class="value-icon">
              <svg viewBox="0 0 48 48" aria-hidden="true" width="28" height="28"><path d="M37 8C23 9 13 15 10 27c-2 8 2 12 8 13 12 2 20-9 19-32z" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M11 39c6-8 12-13 21-18" fill="none" stroke="currentColor" stroke-width="2.5"/></svg>
            </div>
            <h4>Sustainability</h4>
            <p>Mendukung efisiensi energi, keselamatan kerja berkelanjutan, dan kepedulian lingkungan.</p>
          </div>
        </div>
      </div>

      <!-- Legal Credentials -->
      <div class="creds-col">
        <div class="eyebrow dark">Legalitas Perusahaan</div>
        <h2>Legalitas &amp; Sertifikasi</h2>
        <div class="creds-table">
          <div class="cred-row">
            <b>Nama Perusahaan</b>
            <span>PT. VISI BANGUN PERKASA</span>
          </div>
          <div class="cred-row">
            <b>Bentuk Usaha</b>
            <span>Perseroan Terbatas (PT)</span>
          </div>
          <div class="cred-row">
            <b>NPWP</b>
            <span>056099138413000</span>
          </div>
          <div class="cred-row">
            <b>NIB</b>
            <span>2208240083853</span>
          </div>
          <div class="cred-row">
            <b>Alamat Operasional</b>
            <span>Jl. M.T Haryono Km. 4 Setu - Bekasi, Jawa Barat</span>
          </div>
        </div>

        <div class="office-preview">
          <img src="/assets/p8/office-2.jpg" alt="Visi Bangun Perkasa Office Reception" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <CtaSection />
</BaseLayout>

<style>
  /* Company Overview */
  .company-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: center;
  }

  @media (min-width: 900px) {
    .company-grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: var(--space-12);
    }
  }

  .company-text h2 {
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--color-navy);
    line-height: 1.25;
    margin-bottom: var(--space-4);
  }

  .company-text p {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-bottom: var(--space-4);
  }

  .team-photo-wrap {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  .team-photo-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Highlights */
  .highlight-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 600px) {
    .highlight-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .highlight-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-6);
    }
  }

  .highlight-card {
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-normal);
  }

  .highlight-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .hl-badge {
    color: var(--color-blue);
    font-size: 1.25rem;
  }

  .highlight-card strong {
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--color-navy);
    line-height: 1;
  }

  .highlight-card span {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    font-weight: 500;
  }

  .map-card img {
    height: 48px;
    width: auto;
    object-fit: contain;
    margin-bottom: var(--space-1);
  }

  /* Vision Mission */
  .vm-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: center;
  }

  @media (min-width: 960px) {
    .vm-container {
      grid-template-columns: 0.9fr 1.1fr;
      gap: var(--space-12);
      align-items: center;
    }
  }

  .vm-image {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    aspect-ratio: 16 / 10;
    width: 100%;
  }

  @media (min-width: 960px) {
    .vm-image {
      aspect-ratio: 5 / 4;
      width: 100%;
    }
  }

  .vm-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .vm-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .vm-block h3 {
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--color-gold);
    margin-bottom: var(--space-2);
  }

  .vm-block p {
    font-size: var(--text-base);
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.7;
  }

  .vm-divider {
    height: 1px;
    background-color: rgba(255, 255, 255, 0.12);
  }

  .mission-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-left: 20px;
    list-style: decimal;
  }

  .mission-list li {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.6;
  }

  /* Values & Credentials Grid */
  .values-creds-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
  }

  @media (min-width: 960px) {
    .values-creds-grid {
      grid-template-columns: 1.2fr 1fr;
      gap: var(--space-12);
    }
  }

  .values-col h2,
  .creds-col h2 {
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--color-navy);
    margin-bottom: var(--space-6);
  }

  .values-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 540px) {
    .values-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .value-card {
    background-color: var(--color-bg-light);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-5);
  }

  .value-icon {
    color: var(--color-blue);
    margin-bottom: var(--space-2);
  }

  .value-card h4 {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-navy);
    margin-bottom: var(--space-1);
  }

  .value-card p {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  /* Credentials */
  .creds-table {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-bottom: var(--space-6);
  }

  .cred-row {
    display: grid;
    grid-template-columns: 140px 1fr;
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border-subtle);
    font-size: var(--text-xs);
  }

  .cred-row:last-child {
    border-bottom: none;
  }

  .cred-row:nth-child(even) {
    background-color: var(--color-bg-light);
  }

  .cred-row b {
    color: var(--color-navy);
    font-weight: 700;
  }

  .cred-row span {
    color: var(--color-text-secondary);
  }

  .office-preview {
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .office-preview img {
    width: 100%;
    height: auto;
  }
</style>
