---
import BaseLayout from '../layouts/BaseLayout.astro';
import StatsBar from '../components/ui/StatsBar.astro';
import CtaSection from '../components/ui/CtaSection.astro';
import ProjectCard from '../components/portfolio/ProjectCard.astro';
import { getProjects } from '../lib/wordpress/portfolio';

const allProjects = await getProjects();
const featuredProjects = allProjects.slice(0, 4);

const services = [
  {
    title: 'Construction & Civil Infrastructure',
    image: '/assets/p1/service-construction.jpg',
    items: ['Building Construction', 'Civil & Infrastructure Works', 'Structural Works', 'Industrial Construction'],
    href: '/services#construction',
  },
  {
    title: 'Renovation & Interior Fit-Out',
    image: '/assets/p1/service-renovation.jpg',
    items: ['Building Renovation', 'Office & Commercial Renovation', 'Interior & Exterior Works', 'Supply & Pengadaan'],
    href: '/services#renovation',
  },
  {
    title: 'Facility Maintenance & Engineering',
    image: '/assets/p1/service-maintenance.jpg',
    items: ['HVAC Systems', 'Electrical & Genset Systems', 'Building Maintenance', 'Fire System'],
    href: '/services#maintenance',
  },
  {
    title: 'Integrated Technology & Security Solutions',
    image: '/assets/p1/service-integrated.jpg',
    items: ['CCTV & Security Systems', 'Network & Fiber Optic', 'Lightning Protection Systems', 'Control Room Solutions'],
    href: '/services#integrated',
  },
];

const industries = [
  { name: 'Industrial & Manufacturing', image: '/assets/p1/industry-industrial.jpg' },
  { name: 'Mining', image: '/assets/p1/industry-mining.jpg' },
  { name: 'Oil & Gas', image: '/assets/p1/industry-oilgas.jpg' },
  { name: 'Healthcare & Hospital', image: '/assets/p1/industry-healthcare.jpg' },
  { name: 'Plantation', image: '/assets/p1/industry-plantation.jpg' },
  { name: 'Commercial & Infrastructure', image: '/assets/p1/industry-commercial.jpg' },
];
---

<BaseLayout
  title="Visi Bangun Perkasa | Industrial Construction & Integrated Solutions"
  description="PT. Visi Bangun Perkasa — Trusted Partner for Industrial Construction & Integrated Solutions across Indonesia. Building Sustainable Value for a Better Tomorrow."
>
  <!-- Hero Section -->
  <section class="home-hero" aria-label="Hero banner">
    <div class="home-hero-overlay"></div>
    <div class="container home-hero-content">
      <div class="eyebrow">Industrial Construction &amp; Integrated Solutions</div>
      <h1>Building Sustainable Value<br />for a <span>Better Tomorrow</span></h1>
      <p>
        Kami menghadirkan solusi konstruksi, renovasi, facility maintenance dan teknologi terintegrasi untuk industri, dengan fokus pada kualitas, keselamatan, efisiensi dan keberlanjutan.
      </p>
      <div class="hero-actions">
        <a class="btn btn-gold" href="/services">Our Services &rarr;</a>
        <a class="btn btn-outline" href="/projects">View Projects &#9654;</a>
      </div>
    </div>
  </section>

  <!-- Highlight Stats Bar -->
  <StatsBar />

  <!-- Services Section -->
  <section class="section home-services" id="services">
    <div class="container">
      <div class="section-head split">
        <div>
          <div class="eyebrow">Our Services</div>
          <h2>Four Core Services for Your Business</h2>
        </div>
        <p>
          Kami menyediakan layanan terintegrasi untuk mendukung kebutuhan proyek dan operasional bangunan industri, komersial, dan fasilitas umum dengan pendekatan profesional dan berorientasi solusi.
        </p>
      </div>

      <div class="service-grid">
        {services.map((svc) => (
          <div class="service-card">
            <div class="service-image">
              <img src={svc.image} alt={svc.title} loading="lazy" />
            </div>
            <div class="service-body">
              <h3>{svc.title}</h3>
              <ul>
                {svc.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
              <a class="service-learn" href={svc.href}>
                Learn More <b>&rarr;</b>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Approach Section -->
  <section class="home-approach">
    <div class="approach-grid container">
      <div class="approach-img-col">
        <img src="/assets/p1/about-team.jpg" alt="Tim lapangan PT. Visi Bangun Perkasa" loading="lazy" />
      </div>
      <div class="approach-content-col">
        <div class="eyebrow">Our Approach</div>
        <h2>From Planning to Long-Term Partnership</h2>
        <p class="approach-lead">
          Kami menerapkan pendekatan terstruktur untuk memastikan setiap proyek berjalan dengan efektif, efisien, dan memberikan nilai jangka panjang.
        </p>

        <div class="process-steps">
          <div class="process-item">
            <span class="step-num">01</span>
            <div>
              <strong>Consultation</strong>
              <p>Memahami kebutuhan dan memberikan solusi terbaik.</p>
            </div>
          </div>
          <div class="process-item">
            <span class="step-num">02</span>
            <div>
              <strong>Planning &amp; Design</strong>
              <p>Perencanaan teknis dengan standar industri.</p>
            </div>
          </div>
          <div class="process-item">
            <span class="step-num">03</span>
            <div>
              <strong>Execution</strong>
              <p>Implementasi oleh tim profesional dengan pengawasan kualitas.</p>
            </div>
          </div>
          <div class="process-item">
            <span class="step-num">04</span>
            <div>
              <strong>Maintenance</strong>
              <p>Dukungan berkelanjutan untuk menjaga performa aset.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Projects Section -->
  <section class="section home-featured">
    <div class="container">
      <div class="section-head split">
        <div>
          <div class="eyebrow">Featured Projects</div>
          <h2>Selected Project Experience</h2>
        </div>
        <a class="view-all-link" href="/projects">
          View All Projects <b>&rarr;</b>
        </a>
      </div>

      <div class="projects-grid">
        {featuredProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </div>
  </section>

  <!-- Industries Section -->
  <section class="section section-dark home-industries">
    <div class="container">
      <div class="section-head split">
        <div>
          <div class="eyebrow">Our Focus</div>
          <h2>Industries We Serve</h2>
        </div>
        <p>
          Delivering reliable solutions across key industries with deep understanding of operational needs and strict compliance standards.
        </p>
      </div>

      <div class="industry-grid">
        {industries.map((ind) => (
          <a class="industry-item" href="/industries">
            <img src={ind.image} alt={ind.name} loading="lazy" />
            <div class="industry-overlay"></div>
            <span>{ind.name}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <CtaSection />
</BaseLayout>

<style>
  /* Home Hero */
  .home-hero {
    position: relative;
    background-color: var(--color-navy);
    background-image: url('/assets/p1/home-hero.jpg');
    background-size: cover;
    background-position: center;
    color: var(--color-text-light);
    padding-top: clamp(90px, 12vw, 150px);
    padding-bottom: clamp(70px, 10vw, 120px);
    overflow: hidden;
  }

  .home-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(7, 26, 52, 0.94) 0%, rgba(7, 26, 52, 0.82) 55%, rgba(11, 42, 75, 0.75) 100%);
    z-index: 1;
  }

  .home-hero-content {
    position: relative;
    z-index: 2;
    max-width: 860px;
  }

  .home-hero-content h1 {
    font-size: var(--text-5xl);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-4);
  }

  .home-hero-content h1 span {
    color: var(--color-gold);
  }

  .home-hero-content p {
    font-size: var(--text-lg);
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.7;
    max-width: 700px;
    margin-bottom: var(--space-8);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  /* Services Grid */
  .service-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .service-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .service-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .service-card {
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    transition: all var(--transition-normal);
  }

  .service-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: rgba(7, 26, 52, 0.25);
  }

  .service-image {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .service-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .service-card:hover .service-image img {
    transform: scale(1.05);
  }

  .service-body {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: var(--space-3);
  }

  .service-body h3 {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-navy);
    line-height: 1.35;
    min-height: 2.7em;
  }

  .service-body ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }

  .service-body li {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    position: relative;
    padding-left: 14px;
    line-height: 1.5;
  }

  .service-body li::before {
    content: '•';
    position: absolute;
    left: 0;
    color: var(--color-gold);
    font-size: 1.1em;
  }

  .service-learn {
    color: var(--color-blue);
    font-size: var(--text-xs);
    font-weight: 700;
    margin-top: var(--space-2);
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }

  .service-card:hover .service-learn {
    color: var(--color-navy);
    transform: translateX(4px);
  }

  /* Approach Section */
  .home-approach {
    background-color: var(--color-bg-light);
    padding: clamp(60px, 8vw, 100px) 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .approach-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: center;
  }

  @media (min-width: 960px) {
    .approach-grid {
      grid-template-columns: 1fr 1.2fr;
      gap: var(--space-12);
    }
  }

  .approach-img-col {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  .approach-img-col img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .approach-content-col h2 {
    font-size: var(--text-3xl);
    font-weight: 800;
    line-height: 1.2;
    color: var(--color-navy);
    margin-bottom: var(--space-3);
  }

  .approach-lead {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-bottom: var(--space-6);
  }

  .process-steps {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 600px) {
    .process-steps {
      grid-template-columns: 1fr 1fr;
    }
  }

  .process-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4);
    background-color: #ffffff;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
  }

  .step-num {
    font-size: var(--text-base);
    font-weight: 800;
    color: var(--color-gold);
    line-height: 1.2;
    background-color: var(--color-navy);
    width: 32px;
    height: 32px;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .process-item strong {
    font-size: var(--text-sm);
    color: var(--color-navy);
    display: block;
    margin-bottom: 2px;
  }

  .process-item p {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  /* Projects Grid */
  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 600px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .projects-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .view-all-link {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-blue);
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    white-space: nowrap;
  }

  .view-all-link:hover {
    color: var(--color-navy);
  }

  /* Industries */
  .industry-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 500px) {
    .industry-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .industry-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-6);
    }
  }

  .industry-item {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    aspect-ratio: 16 / 10;
    box-shadow: var(--shadow-sm);
  }

  .industry-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .industry-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(7, 26, 52, 0.2) 0%, rgba(7, 26, 52, 0.85) 100%);
    transition: opacity var(--transition-fast);
  }

  .industry-item span {
    position: absolute;
    bottom: var(--space-4);
    left: var(--space-4);
    right: var(--space-4);
    color: #ffffff;
    font-size: var(--text-base);
    font-weight: 700;
    z-index: 2;
  }

  .industry-item:hover img {
    transform: scale(1.08);
  }
</style>
